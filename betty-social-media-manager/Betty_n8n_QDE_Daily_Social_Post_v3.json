{
  "name": "Betty — QDE Daily Social Post (Metricool drafts) v3",
  "settings": {
    "timezone": "America/Chicago",
    "executionOrder": "v1"
  },
  "meta": {
    "notes": "One READY row per day → graphic (if none) → Metricool DRAFT for Facebook and LinkedIn → sheet updated → reviewer pinged. Agent never schedules. See Betty_n8n_QDE_Daily_Social_Post_SOP_v1.md for setup and every [TO VERIFY]."
  },
  "nodes": [
    {
      "id": "n01",
      "name": "Daily 7:00 CT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 7 * * 1-5" }
          ]
        }
      }
    },
    {
      "id": "n02",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "metricool_blogId", "type": "string", "value": "6268508" },
            { "id": "c2", "name": "metricool_userId", "type": "string", "value": "4831552" },
            { "id": "c3", "name": "sheet_id", "type": "string", "value": "14pkeLjlH5SFf4X_DwafTCJlgdKRNOcY-p_AAbZjxfec" },
            { "id": "c4", "name": "sheet_gid", "type": "string", "value": "0" },
            { "id": "c5", "name": "drive_folder_id", "type": "string", "value": "[TO VERIFY — Drive folder for generated social graphics]" },
            { "id": "c6", "name": "gemini_image_model", "type": "string", "value": "gemini-2.5-flash-image" },
            { "id": "c7", "name": "reviewer_slack_channel", "type": "string", "value": "[TO VERIFY — e.g. #qde-review]" },
            { "id": "c8", "name": "timezone", "type": "string", "value": "America/Chicago" },
            { "id": "c9", "name": "placeholder_publish_time", "type": "string", "value": "09:00:00" }
          ]
        },
        "includeOtherFields": true
      }
    },
    {
      "id": "n03",
      "name": "Read queue (READY rows)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 300],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $json.sheet_id }}" },
        "sheetName": { "__rl": true, "mode": "id", "value": "={{ $json.sheet_gid }}" },
        "filtersUI": {
          "values": [
            { "lookupColumn": "status", "lookupValue": "READY" }
          ]
        },
        "options": { "returnFirstMatch": true }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "[SET IN N8N]", "name": "Google Sheets — Baggett" } }
    },
    {
      "id": "n04",
      "name": "Queue has a post?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "q1",
              "operator": { "type": "string", "operation": "notEmpty" },
              "leftValue": "={{ $json.post_id }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "n05",
      "name": "Queue empty — tell reviewer",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [880, 520],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "={{ $('Config').item.json.reviewer_slack_channel }}" },
        "text": "QDE daily post: the queue has no READY rows. Nothing was staged today. Mark a row READY in QDE_Post_Queue to resume.",
        "otherOptions": {}
      },
      "credentials": { "slackOAuth2Api": { "id": "[SET IN N8N]", "name": "Slack — Baggett" } }
    },
    {
      "id": "n06",
      "name": "Preflight checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200],
      "parameters": {
        "jsCode": "// Betty publishes copy verbatim. She checks it, she never edits it.\nconst row = $input.first().json;\nconst cap = String(row.caption || '');\nconst problems = [];\nif (!cap.trim()) problems.push('caption is empty');\nif (!cap.includes('1-800-980-9030')) problems.push('phone number missing');\nif (!cap.includes('HandwritingExpertUSA.com')) problems.push('HandwritingExpertUSA.com missing');\nif (/HandwritingExpert\\.com/i.test(cap)) problems.push('banned domain HandwritingExpert.com present');\nif (/link in bio/i.test(cap)) problems.push('\"link in bio\" present');\nif (/graphol/i.test(cap)) problems.push('\"graphology\" present');\nif (/\\[TO VERIFY\\]|\\*\\*\\*\\*/.test(cap)) problems.push('unresolved [TO VERIFY] / **** marker in caption');\nif (/win your case|guarantee/i.test(cap)) problems.push('outcome claim language');\nif (String(row.facts_need_verify).toUpperCase() === 'YES') problems.push('facts_need_verify = YES');\nif (String(row.photo_required).toUpperCase() === 'YES' && !String(row.image_url||'').trim()) problems.push('photo_required = YES but image_url is empty — a real face must be composited by a human first');\nreturn [{ json: { ...row, preflight_ok: problems.length === 0, preflight_problems: problems.join('; ') } }];"
      }
    },
    {
      "id": "n07",
      "name": "Preflight passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "p1",
              "operator": { "type": "boolean", "operation": "true" },
              "leftValue": "={{ $json.preflight_ok }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "n08",
      "name": "Mark row BLOCKED",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1320, 420],
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $('Config').item.json.sheet_id }}" },
        "sheetName": { "__rl": true, "mode": "id", "value": "={{ $('Config').item.json.sheet_gid }}" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["post_id"],
          "value": {
            "post_id": "={{ $json.post_id }}",
            "status": "BLOCKED",
            "notes": "={{ 'Preflight: ' + $json.preflight_problems }}"
          }
        }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "[SET IN N8N]", "name": "Google Sheets — Baggett" } }
    },
    {
      "id": "n09",
      "name": "Blocked — tell reviewer",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1540, 420],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "={{ $('Config').item.json.reviewer_slack_channel }}" },
        "text": "=QDE daily post BLOCKED — {{ $('Preflight checks').item.json.post_id }} ({{ $('Preflight checks').item.json.headline }}). Reason: {{ $('Preflight checks').item.json.preflight_problems }}. Nothing was sent to Metricool.",
        "otherOptions": {}
      },
      "credentials": { "slackOAuth2Api": { "id": "[SET IN N8N]", "name": "Slack — Baggett" } }
    },
    {
      "id": "n10",
      "name": "Has image already?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "i1",
              "operator": { "type": "string", "operation": "notEmpty" },
              "leftValue": "={{ $json.image_url }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "n11",
      "name": "Gemini — generate graphic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 200],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Config').item.json.gemini_image_model }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.image_prompt + ' Render the exact headline text \"' + $json.headline + '\" with only the word \"' + $json.gold_word + '\" in gold (#FFE455). Sub-line: \"' + $json.subline + '\". Torn-note text: \"' + $json.torn_note + '\". 4:5 portrait, 1080x1350.' }] }], generationConfig: { responseModalities: ['IMAGE'] } }) }}",
        "options": {}
      },
      "credentials": { "httpHeaderAuth": { "id": "[SET IN N8N]", "name": "Gemini API key (header x-goog-api-key)" } }
    },
    {
      "id": "n12",
      "name": "Base64 → PNG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 200],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst parts = (((resp.candidates||[])[0]||{}).content||{}).parts||[];\nconst img = parts.find(p => p.inlineData && p.inlineData.data);\nif (!img) throw new Error('Gemini returned no image. Raw: ' + JSON.stringify(resp).slice(0,500));\nconst row = $('Preflight checks').first().json;\nconst buf = Buffer.from(img.inlineData.data, 'base64');\nconst bin = await this.helpers.prepareBinaryData(buf, row.post_id + '_1080x1350.png', img.inlineData.mimeType || 'image/png');\nreturn [{ json: { post_id: row.post_id }, binary: { data: bin } }];"
      }
    },
    {
      "id": "n13",
      "name": "Upload PNG to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1980, 200],
      "parameters": {
        "operation": "upload",
        "name": "={{ $json.post_id }}_1080x1350.png",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive" },
        "folderId": { "__rl": true, "mode": "id", "value": "={{ $('Config').item.json.drive_folder_id }}" },
        "options": {}
      },
      "credentials": { "googleDriveOAuth2Api": { "id": "[SET IN N8N]", "name": "Google Drive — Baggett" } }
    },
    {
      "id": "n14",
      "name": "Share: anyone with link",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [2200, 200],
      "parameters": {
        "operation": "share",
        "fileId": { "__rl": true, "mode": "id", "value": "={{ $json.id }}" },
        "permissionsUi": { "permissionsValues": { "role": "reader", "type": "anyone" } },
        "options": {}
      },
      "credentials": { "googleDriveOAuth2Api": { "id": "[SET IN N8N]", "name": "Google Drive — Baggett" } }
    },
    {
      "id": "n15",
      "name": "Set image_url (generated)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2420, 200],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "g1", "name": "image_url", "type": "string", "value": "={{ 'https://drive.google.com/uc?id=' + $('Upload PNG to Drive').item.json.id }}" },
            { "id": "g2", "name": "image_source", "type": "string", "value": "generated" }
          ]
        },
        "includeOtherFields": false
      }
    },
    {
      "id": "n16",
      "name": "Set image_url (pre-built)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1540, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "h1", "name": "image_url", "type": "string", "value": "={{ $json.image_url }}" },
            { "id": "h2", "name": "image_source", "type": "string", "value": "pre-built" }
          ]
        },
        "includeOtherFields": false
      }
    },
    {
      "id": "n17",
      "name": "Assemble post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 100],
      "parameters": {
        "jsCode": "const row = $('Preflight checks').first().json;\nconst cfg = $('Config').first().json;\nconst img = $input.first().json;\n// Placeholder publication date: next weekday at the configured time. draft:true means it cannot fire; the reviewer sets the real time.\nconst d = new Date(); d.setDate(d.getDate() + 1);\nwhile (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);\nconst ymd = d.toISOString().slice(0,10);\nconst base = {\n  text: row.caption,\n  media: [img.image_url],\n  mediaAltText: [row.headline + ' — ' + row.subline],\n  draft: true,\n  autoPublish: true,\n  shortener: false,\n  hasNotReadNotes: false,\n  descendants: [],\n  firstCommentText: '',\n  smartLinkData: { ids: [] },\n  publicationDate: { dateTime: ymd + 'T' + cfg.placeholder_publish_time, timezone: cfg.timezone }\n};\nconst fb = { ...base, providers: [{ network: 'facebook' }], facebookData: { type: 'POST' } };\nconst li = { ...base, providers: [{ network: 'linkedin' }], linkedinData: { type: 'post', previewIncluded: true, publishImagesAsPDF: false } };\nreturn [{ json: { post_id: row.post_id, headline: row.headline, image_url: img.image_url, image_source: img.image_source, fb_body: fb, li_body: li } }];"
      }
    },
    {
      "id": "n18",
      "name": "Metricool — Facebook DRAFT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 0],
      "parameters": {
        "method": "POST",
        "url": "=https://app.metricool.com/api/v2/scheduler/posts?blogId={{ $('Config').item.json.metricool_blogId }}&userId={{ $('Config').item.json.metricool_userId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.fb_body) }}",
        "options": {}
      },
      "credentials": { "httpHeaderAuth": { "id": "[SET IN N8N]", "name": "Metricool (header X-Mc-Auth)" } }
    },
    {
      "id": "n19",
      "name": "Metricool — LinkedIn DRAFT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 200],
      "parameters": {
        "method": "POST",
        "url": "=https://app.metricool.com/api/v2/scheduler/posts?blogId={{ $('Config').item.json.metricool_blogId }}&userId={{ $('Config').item.json.metricool_userId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Assemble post').item.json.li_body) }}",
        "options": {}
      },
      "credentials": { "httpHeaderAuth": { "id": "[SET IN N8N]", "name": "Metricool (header X-Mc-Auth)" } }
    },
    {
      "id": "n20",
      "name": "Mark row STAGED",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [3080, 100],
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $('Config').item.json.sheet_id }}" },
        "sheetName": { "__rl": true, "mode": "id", "value": "={{ $('Config').item.json.sheet_gid }}" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["post_id"],
          "value": {
            "post_id": "={{ $('Assemble post').item.json.post_id }}",
            "status": "STAGED",
            "image_url": "={{ $('Assemble post').item.json.image_url }}",
            "metricool_fb_id": "={{ $('Metricool — Facebook DRAFT').item.json.data ? $('Metricool — Facebook DRAFT').item.json.data.id : JSON.stringify($('Metricool — Facebook DRAFT').item.json).slice(0,120) }}",
            "metricool_li_id": "={{ $json.data ? $json.data.id : JSON.stringify($json).slice(0,120) }}",
            "date_staged": "={{ $now.setZone('America/Chicago').toFormat('yyyy-LL-dd HH:mm') }}"
          }
        }
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "[SET IN N8N]", "name": "Google Sheets — Baggett" } }
    },
    {
      "id": "n21",
      "name": "Staged — tell reviewer",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [3300, 100],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "={{ $('Config').item.json.reviewer_slack_channel }}" },
        "text": "=QDE daily post staged as DRAFTS in Metricool — {{ $('Assemble post').item.json.post_id }}: {{ $('Assemble post').item.json.headline }}\nImage ({{ $('Assemble post').item.json.image_source }}): {{ $('Assemble post').item.json.image_url }}\nFacebook: {{ $('Metricool — Facebook DRAFT').item.json.data && $('Metricool — Facebook DRAFT').item.json.data.plannerUrl ? $('Metricool — Facebook DRAFT').item.json.data.plannerUrl : 'see Metricool planner' }}\nLinkedIn: {{ $('Metricool — LinkedIn DRAFT').item.json.data && $('Metricool — LinkedIn DRAFT').item.json.data.plannerUrl ? $('Metricool — LinkedIn DRAFT').item.json.data.plannerUrl : 'see Metricool planner' }}\nNothing is scheduled. Approve by scheduling the drafts in the planner.",
        "otherOptions": {}
      },
      "credentials": { "slackOAuth2Api": { "id": "[SET IN N8N]", "name": "Slack — Baggett" } }
    }
  ],
  "connections": {
    "Daily 7:00 CT": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Read queue (READY rows)", "type": "main", "index": 0 }]] },
