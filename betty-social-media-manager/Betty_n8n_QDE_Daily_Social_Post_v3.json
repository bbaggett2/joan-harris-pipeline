    "Upload PNG to Drive": { "main": [[{ "node": "Share: anyone with link", "type": "main", "index": 0 }]] },
    "Share: anyone with link": { "main": [[{ "node": "Set image_url (generated)", "type": "main", "index": 0 }]] },
