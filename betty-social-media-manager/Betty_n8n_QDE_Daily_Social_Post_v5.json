    {
      "id": "n12",
      "name": "Base64 → PNG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst b64 = resp && resp.data && resp.data[0] && resp.data[0].b64_json;\nif (!b64) throw new Error('OpenAI returned no image. Raw: ' + JSON.stringify(resp).slice(0,500));\nconst row = $('Preflight checks').first().json;\nconst buf = Buffer.from(b64, 'base64');\nconst stamp = $now.setZone('America/Chicago').toFormat('yyyyLLdd-HHmm');\nconst bin = await this.helpers.prepareBinaryData(buf, row.post_id + '_' + stamp + '_1024x1536.png', 'image/png');\nreturn [{ json: { post_id: row.post_id }, binary: { data: bin } }];"
      }
