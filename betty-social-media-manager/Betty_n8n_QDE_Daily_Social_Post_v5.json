    {
      "id": "n17",
      "name": "Assemble post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        100
      ],
      "parameters": {
        "jsCode": "const row = $('Preflight checks').first().json;\nconst cfg = $('Config').first().json;\nconst img = $input.first().json;\n// v5: publish slot = latest publish_date among STAGED/PUBLISHED rows + 1 weekday; never today or earlier;\n// never a day another QDE post already holds. One post per weekday, 24 hours apart.\nconst taken = $('Read scheduled dates').all().map(i => i.json.publish_date).filter(Boolean).map(s => String(s).slice(0,10));\nconst tz = cfg.timezone || 'America/Chicago';\nlet d = $now.setZone(tz).startOf('day').plus({ days: 1 });\nif (taken.length) {\n  const latest = taken.sort().slice(-1)[0];\n  const l = DateTime.fromISO(latest, { zone: tz }).plus({ days: 1 });\n  if (l > d) d = l;\n}\nwhile (d.weekday > 5 || taken.includes(d.toISODate())) d = d.plus({ days: 1 });\nconst ymd = d.toISODate();\nconst base = {\n  text: row.caption,\n  media: [img.image_url],\n  mediaAltText: [row.headline + ' — ' + row.subline],\n  draft: true,\n  saveExternalMediaFiles: true,\n  autoPublish: true,\n  shortener: false,\n  hasNotReadNotes: false,\n  descendants: [],\n  firstCommentText: '',\n  smartLinkData: { ids: [] },\n  publicationDate: { dateTime: ymd + 'T' + cfg.placeholder_publish_time, timezone: tz }\n};\nconst fb = { ...base, providers: [{ network: 'facebook' }], facebookData: { type: 'POST' } };\nconst li = { ...base, providers: [{ network: 'linkedin' }], linkedinData: { type: 'post', previewIncluded: true, publishImagesAsPDF: false } };\nreturn [{ json: { post_id: row.post_id, headline: row.headline, image_url: img.image_url, image_source: img.image_source, publish_date: ymd, fb_body: fb, li_body: li } }];"
      }
    },
